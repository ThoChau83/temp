# Sao chép thành .env rồi chỉnh nếu cần. Đường dẫn tương đối tính từ thư mục api/.

# File SQLite (tạo bằng: python scripts/init_db.py)
DB_PATH=data/moc_mien.db

# Chính sách máy đọc được (mặc định ../policy.yaml)
POLICY_PATH=../policy.yaml

# Đồng hồ giả lập để dữ liệu seed và kịch bản test luôn tái lập được.
# Đặt MOCK_NOW=off để dùng giờ thật (khi đó các đơn "tương lai" trong seed sẽ thành quá khứ).
MOCK_NOW=2026-10-16T08:00:00+07:00

# Khoá cho agent gọi API qua header X-API-Key. Để trống = không yêu cầu.
API_KEY=

# Khoá cho các endpoint nội bộ /staff/* (header X-Staff-Key)
STAFF_KEY=mocmien-staff-2026
